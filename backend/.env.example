# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shikshadisha
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production-use-32-char-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
GEMINI_API_KEY=your-gemini-api-key
SERP_API_KEY=your-serp-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key
UPLOADCARE_PUBLIC_KEY=your-uploadcare-public-key
UPLOADCARE_SECRET_KEY=your-uploadcare-secret-key

# Payments (POLAR.SH)
POLAR_API_KEY=your-polar-api-key
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
POLAR_PRO_CHECKOUT_URL=your-polar-pro-checkout-url
POLAR_PREMIUM_CHECKOUT_URL=your-polar-premium-checkout-url
POLAR_PRO_PRODUCT_ID=your-polar-pro-product-id
POLAR_PREMIUM_PRODUCT_ID=your-polar-premium-product-id
APPS_SCRIPT_URL=your-google-apps-script-web-app-url

# Sentry
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60